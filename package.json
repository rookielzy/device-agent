{
  "name": "device-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20 <21"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/server.js",
    "dev:server": "pnpm build && node dist/src/server.js",
