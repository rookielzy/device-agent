    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@langchain/core": "1.1.48",
    "@langchain/deepseek": "1.0.27",
    "fastify": "5.8.5",
    "langchain": "1.4.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "20.19.42",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  }
}
